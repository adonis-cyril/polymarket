# PostgreSQL (bot + dashboard)
DATABASE_URL=postgresql://polymarket:polymarket@localhost:5432/polymarket

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Polymarket
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=...
POLY_API_SECRET=...
POLY_API_PASSPHRASE=...
POLY_FUNDER_ADDRESS=0x...
# 1 = proxy wallet, 3 = deposit wallet (uses py-clob-client-v2 in execution/order.py)
POLY_SIGNATURE_TYPE=1

# Bot config
STARTING_BANKROLL=5.00
INITIAL_BANKROLL=5.00
MIN_BET=1.00
# Fixed USDC per trade (0 = Kelly / HFT fraction). $1 needs ask ≤ $0.20 (5-share minimum).
BET_SIZE=1.00
# Total USDC cap for this bot run (e.g. 5 x $1 trades). 0 = unlimited.
MAX_SESSION_SPEND=5.00
DAILY_LOSS_LIMIT=0.20
DRAWDOWN_CAP=0.40
CONSECUTIVE_LOSS_PAUSE=5

# Dashboard (Next.js) and TUI entry (python start.py)
ADMIN_PASSWORD=your-secret-password
# Optional TUI-only override (falls back to ADMIN_PASSWORD)
# TUI_ADMIN_PASSWORD=your-tui-password

# Bot mode: standard (default) or hft (quick scalp strategy)
BOT_MODE=standard

# Realtime thinking — verbose decision stream during evaluation
REALTIME_THINKING=true
# Realtime logging — console + optional file persistence
REALTIME_LOGGING=true
REALTIME_LOG_LEVEL=DEBUG
REALTIME_LOG_FILE=logs/bot_realtime.log

# HFT scalp mode (BOT_MODE=hft or python bot.py --hft)
HFT_TAKE_PROFIT_PCT=0.02      # 2% quick profit target
HFT_STOP_LOSS_PCT=0.015       # 1.5% tight stop
HFT_MAX_HOLD_SECONDS=30       # force exit if TP/SL not hit
HFT_MIN_SIGNAL_SCORE=2.0      # lower entry threshold for faster fills
HFT_BET_FRACTION=0.10         # fraction of balance per scalp
HFT_POLL_INTERVAL=0.5         # position poll interval (seconds)

# Active markets registry (full catalog cache — see scripts/refresh_markets.py)
ACTIVE_MARKETS_CACHE_ENABLED=true
ACTIVE_MARKETS_DB_PERSIST=true
ACTIVE_MARKETS_CACHE_TTL=300
ACTIVE_MARKETS_FETCH_PAGE_SIZE=100
ACTIVE_MARKETS_SYNC_ON_STARTUP=false

# Polymarket connectivity (optional — auto-bypasses ISP DNS blocks by default)
# POLYMARKET_DNS_AUTO_FIX=true
# POLYMARKET_DNS_SERVERS=1.1.1.1,8.8.8.8
# POLYMARKET_HTTP_TIMEOUT=20
# POLYMARKET_HOST_OVERRIDES=gamma-api.polymarket.com:172.64.153.51,clob.polymarket.com:172.64.153.51

# Live staircase manual tests (python -m tests.live_staircase)
STAIRCASE_DEFAULT_SIZE=2.00
STAIRCASE_TP_PCT=0.02
STAIRCASE_SL_PCT=0.015
STAIRCASE_LOG_FILE=logs/staircase.log

# Terminal workstation (uv run polymarket-tui)
TUI_THEME=polyadonis
TUI_REFRESH_INTERVAL=2.0
TUI_LOG_LEVEL=INFO
TUI_LOG_FILE=logs/tui.log
TUI_CHART_HISTORY=60
TUI_MARKETS_LIMIT=50
TUI_TRADES_LIMIT=100